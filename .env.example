# Zugangsdaten der Discord-App "BeerBrawl Sprecheranzeige" (Developer Portal).
# Diese Datei nach .env kopieren und ausfüllen. .env kommt nie ins Repo.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Muss genau so im Developer Portal unter OAuth2 > Redirects stehen.
# DISCORD_REDIRECT_URI=http://localhost

# Nur ändern, wenn Discord die Anmeldung wegen der Scopes ablehnt.
# DISCORD_SCOPES=rpc rpc.voice.read identify
